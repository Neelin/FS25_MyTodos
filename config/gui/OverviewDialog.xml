<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    Komplettuebersicht als Engine-Dialog (MessageDialog-Subklasse, siehe
    scripts/gui/MyTodosOverviewDialog.lua). Aufbau nach dem Vorbild
    FS25_FarmlandOverview/gui/FieldDlgFrame.xml: Fullscreen-Dim,
    Dialog-Body, Titel, statische Spaltenkoepfe, SmoothList mit
    Section-Headern (listSectionHeader-Template) + Slider, Back-Button.
    Der Back-Button traegt ueber das Vanilla-buttonBack-Profil die
    MENU_BACK-Bindung -> ESC und Controller-B schliessen den Dialog.

    Custom-Profile (myTodos_dlg*) liegen in config/gui/GUIProfiles.xml.
-->
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="1240px 800px">
        <ThreePartBitmap profile="fs25_dialogBgMiddle" />
        <ThreePartBitmap profile="fs25_dialogBgTop" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />
        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="dialogTitle" text="$l10n_myTodos_overview_title" id="dialogTitleElement" position="0px -30px" />

            <!-- Statische Spaltenkoepfe ueber der Liste -->
            <Bitmap profile="myTodos_dlgPanel" id="tableHeaderBox" position="45px -90px" size="1140px 40px">
                <Text profile="myTodos_dlgHeaderText" position="40px 0px" size="240px 40px" text="$l10n_myTodos_overview_col_name"/>
                <Text profile="myTodos_dlgHeaderText" position="290px 0px" size="380px 40px" text="$l10n_myTodos_overview_col_task"/>
                <Text profile="myTodos_dlgHeaderText" position="680px 0px" size="450px 40px" text="$l10n_myTodos_overview_col_extra"/>
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
            </Bitmap>

            <SmoothList profile="myTodos_dlgPanel" id="taskTable" position="50px -140px" size="1140px 540px"
                        listSectionHeader="sectionHeader" focusInit="onOpen"
                        focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="myTodos_dlgSectionItem" name="sectionHeader" size="1140px 40px">
                    <Text profile="myTodos_dlgSectionTitle" position="5px 0px" size="1100px 40px" name="title"/>
                </ListItem>
                <ListItem profile="myTodos_dlgListItem" name="row" size="1140px 40px">
                    <Bitmap profile="myTodos_dlgCellImage" position="8px 0px" name="ftIcon" />
                    <Text profile="myTodos_dlgCell" position="40px 0px" size="240px 40px" name="name" textLayoutMode="scrolling"/>
                    <Text profile="myTodos_dlgCell" position="290px 0px" size="380px 40px" name="task" textLayoutMode="scrolling"/>
                    <Text profile="myTodos_dlgCell" position="680px 0px" size="450px 40px" name="extra" textLayoutMode="scrolling"/>
                </ListItem>
            </SmoothList>

            <ThreePartBitmap profile="fs25_listSliderBox" position="-15px -60px" size="12px 545px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 537px" dataElementId="taskTable" id="tableSlider" />
            </ThreePartBitmap>
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" size="1000px 60px">
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" />
        </BoxLayout>
    </GuiElement>
</GUI>
